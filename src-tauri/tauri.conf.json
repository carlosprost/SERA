{
  "productName": "SERA",
  "version": "4.2.1",
  "identifier": "WolfTeI.SERADesktop",
  "build": {
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist/sera/browser"
  },
  "app": {
    "windows": [
      {
        "title": "SERA — Sistema de Expedientes de Registro Avanzado",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline' blob:; font-src 'self' data:; img-src * data: blob: asset: https://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https://raw.githubusercontent.com"
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "publisher": "WolfTeI",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
