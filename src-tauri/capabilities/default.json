{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "sera-default",
  "description": "Permisos predeterminados de SERA para acceso a comandos del backend y eventos del sistema",
  "windows": ["main"],
    "permissions": [
      "core:default",
      "shell:allow-open",
      "dialog:allow-save",
      "dialog:allow-open",
      "fs:allow-read-file",
      "fs:allow-write-file",
      "fs:allow-appdata-read-recursive",
      "fs:allow-appdata-write-recursive",
      "fs:allow-exists"
    ]
}
